# Copie este archivo a practica4/poblar/.env y llene los valores.
# .env no se sube al repositorio. Si una variable ya está definida en el entorno,
# poblar.sh usa esa y no la de este archivo.

# Base que se puebla. No use `comandas` ni `comandas_pruebas`: son de sql/Makefile.
PGDATABASE=comandas_carga

# Usuario que crea la base, corre las migraciones y crea los otros usuarios.
ADMIN_USUARIO=usuario_administrador

# Contraseñas de los usuarios de cada rol. La carga entra como app_comandas.
COMANDAS_APP_CLAVE=contrasena_de_app_comandas
COMANDAS_CONSULTA_CLAVE=contrasena_de_consulta_comandas
COMANDAS_ADMIN_CLAVE=contrasena_de_admin_comandas

# Opcionales.
# MOTOR=docker
# CONTENEDOR=practica1-postgres
