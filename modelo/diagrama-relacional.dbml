// Diagrama relacional del Sistema de Comandas en DBML.
// Se puede pegar en https://dbdiagram.io o importar en ChartDB.
// Generado desde el catálogo de la base comandas (PostgreSQL 16).

Table acuerdo {
  numero_evento "integer"
  numero_paquete "integer"
  id_producto "integer"
  cantidad_acordada "integer" [not null]
  indexes {
    (numero_evento, numero_paquete, id_producto) [pk]
  }
}

Table anticipo {
  id_anticipo "integer" [pk]
  monto "numeric(10,2)" [not null]
  fecha "date" [not null]
  fecha_dia "smallint" [note: 'columna generada']
  fecha_mes "smallint" [note: 'columna generada']
  fecha_anio "smallint" [note: 'columna generada']
  numero_evento "integer" [not null]
}

Table bar_cocina {
  id_usuario "integer" [pk]
  rol "character varying(12)" [not null]
  estado "character varying(10)" [not null]
  estacion_asignada "character varying(6)" [not null]
}

Table cajero_admin {
  id_usuario "integer" [pk]
  rol "character varying(12)" [not null]
  nivel_acceso "character varying(13)" [not null]
  caja_asignada "smallint" [not null]
}

Table comanda {
  id_comanda "integer" [pk]
  fecha_hora "timestamp with time zone" [not null]
  fecha_hora_dia "smallint" [note: 'columna generada']
  fecha_hora_mes "smallint" [note: 'columna generada']
  fecha_hora_anio "smallint" [note: 'columna generada']
  fecha_hora_hora "time without time zone" [note: 'columna generada']
  precio_cobrado "numeric(10,2)" [not null]
  estado "character varying(14)" [not null]
  detalles "character varying(255)"
  numero_evento "integer" [not null]
  secuencial "smallint" [not null]
  id_mesero "integer" [not null]
  id_producto "integer" [not null]
  id_bar_cocina "integer"
  id_cajero_cancela "integer"
}

Table cuenta {
  numero_evento "integer"
  secuencial "smallint"
  numero_mesa "smallint" [not null]
  folio "character varying(30)" [note: 'columna generada']
  estado "character varying(8)" [not null]
  indexes {
    (numero_evento, secuencial) [pk]
  }
}

Table evento {
  numero_evento "integer" [pk]
  fecha "date" [not null]
  fecha_dia "smallint" [note: 'columna generada']
  fecha_mes "smallint" [note: 'columna generada']
  fecha_anio "smallint" [note: 'columna generada']
  tipo_evento "character varying(40)" [not null]
  numero_asistentes "integer" [not null]
  estado "character varying(12)" [not null]
}

Table evento_organizador {
  numero_evento "integer"
  organizador "character varying(120)"
  indexes {
    (numero_evento, organizador) [pk]
  }
}

Table mesa {
  numero_evento "integer"
  numero_mesa "smallint"
  id_mesero "integer" [not null]
  indexes {
    (numero_evento, numero_mesa) [pk]
  }
}

Table mesero {
  id_usuario "integer" [pk]
  rol "character varying(12)" [not null]
  turno_asignado "character varying(12)" [not null]
}

Table pago {
  numero_pago "integer" [pk]
  monto "numeric(10,2)" [not null]
  forma_pago "character varying(13)" [not null]
  fecha_hora "timestamp with time zone" [not null]
  fecha_hora_dia "smallint" [note: 'columna generada']
  fecha_hora_mes "smallint" [note: 'columna generada']
  fecha_hora_anio "smallint" [note: 'columna generada']
  fecha_hora_hora "time without time zone" [note: 'columna generada']
  numero_evento "integer" [not null]
  secuencial "smallint" [not null]
  id_cajero "integer" [not null]
  id_mesero_propina "integer"
  monto_propina "numeric(10,2)"
}

Table paquete {
  numero_paquete "integer" [pk]
  monto "numeric(10,2)" [not null]
  detalles "character varying(255)" [not null]
}

Table paquete_producto {
  numero_paquete "integer"
  id_producto "integer"
  indexes {
    (numero_paquete, id_producto) [pk]
  }
}

Table producto {
  id_producto "integer" [pk]
  nombre "character varying(80)" [not null, unique]
  descripcion "character varying(255)"
  categoria "character varying(10)" [not null]
  precio "numeric(10,2)" [not null]
  id_producto_principal "integer"
}

Table ingrediente {
  id_ingrediente "integer" [pk]
  nombre "character varying(60)" [not null, unique]
  unidad_medida "character varying(5)" [not null]
  stock_actual "numeric(10,3)" [not null]
  stock_minimo "numeric(10,3)" [not null]
}

Table receta {
  id_producto "integer"
  id_ingrediente "integer"
  cantidad_por_porcion "numeric(10,3)" [not null]
  indexes {
    (id_producto, id_ingrediente) [pk]
  }
}

Table usuario {
  id_usuario "integer" [pk]
  nombre "character varying(120)" [not null]
  usuario "character varying(40)" [not null, unique]
  fecha_nacimiento "date" [not null]
  fecha_nacimiento_dia "smallint" [note: 'columna generada']
  fecha_nacimiento_mes "smallint" [note: 'columna generada']
  fecha_nacimiento_anio "smallint" [note: 'columna generada']
  contrasena_hash "character varying(255)" [not null]
  rol "character varying(12)" [not null]
}

Ref fk_evento_organizador_evento: evento_organizador.numero_evento > evento.numero_evento [delete: cascade, update: cascade]
Ref fk_mesero_usuario: mesero.(id_usuario, rol) > usuario.(id_usuario, rol) [delete: cascade, update: restrict]
Ref fk_bar_cocina_usuario: bar_cocina.(id_usuario, rol) > usuario.(id_usuario, rol) [delete: cascade, update: restrict]
Ref fk_cajero_admin_usuario: cajero_admin.(id_usuario, rol) > usuario.(id_usuario, rol) [delete: cascade, update: restrict]
Ref fk_mesa_evento: mesa.numero_evento > evento.numero_evento [delete: cascade, update: cascade]
Ref fk_mesa_mesero: mesa.id_mesero > mesero.id_usuario [delete: restrict, update: restrict]
Ref fk_cuenta_evento: cuenta.numero_evento > evento.numero_evento [delete: cascade, update: cascade]
Ref fk_cuenta_mesa: cuenta.(numero_evento, numero_mesa) > mesa.(numero_evento, numero_mesa) [delete: restrict, update: restrict]
Ref fk_producto_principal: producto.id_producto_principal > producto.id_producto [delete: restrict, update: restrict]
Ref fk_receta_producto: receta.id_producto > producto.id_producto [delete: cascade, update: cascade]
Ref fk_receta_ingrediente: receta.id_ingrediente > ingrediente.id_ingrediente [delete: restrict, update: cascade]
Ref fk_paquete_producto_paquete: paquete_producto.numero_paquete > paquete.numero_paquete [delete: cascade, update: cascade]
Ref fk_paquete_producto_producto: paquete_producto.id_producto > producto.id_producto [delete: restrict, update: cascade]
Ref fk_acuerdo_evento: acuerdo.numero_evento > evento.numero_evento [delete: cascade, update: cascade]
Ref fk_acuerdo_paquete: acuerdo.numero_paquete > paquete.numero_paquete [delete: restrict, update: cascade]
Ref fk_acuerdo_producto: acuerdo.id_producto > producto.id_producto [delete: restrict, update: cascade]
Ref fk_comanda_bar_cocina: comanda.id_bar_cocina > bar_cocina.id_usuario [delete: restrict, update: restrict]
Ref fk_comanda_cajero_cancela: comanda.id_cajero_cancela > cajero_admin.id_usuario [delete: restrict, update: restrict]
Ref fk_comanda_cuenta: comanda.(numero_evento, secuencial) > cuenta.(numero_evento, secuencial) [delete: restrict, update: cascade]
Ref fk_comanda_mesero: comanda.id_mesero > mesero.id_usuario [delete: restrict, update: restrict]
Ref fk_comanda_producto: comanda.id_producto > producto.id_producto [delete: restrict, update: cascade]
Ref fk_pago_cajero: pago.id_cajero > cajero_admin.id_usuario [delete: restrict, update: restrict]
Ref fk_pago_cuenta: pago.(numero_evento, secuencial) > cuenta.(numero_evento, secuencial) [delete: restrict, update: cascade]
Ref fk_pago_mesero_propina: pago.id_mesero_propina > mesero.id_usuario [delete: restrict, update: restrict]
Ref fk_anticipo_evento: anticipo.numero_evento > evento.numero_evento [delete: restrict, update: cascade]
